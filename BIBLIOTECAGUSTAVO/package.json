{
  "name": "biblioteca",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up --wait --wait-timeout 60 mongodb",
    "db:down": "docker compose stop mongodb",
    "db:logs": "docker compose logs -f mongodb",
    "db:reset": "docker compose down --volumes",
    "predev": "npm run db:up",
    "dev": "node --watch src/server.js",
    "prestart": "npm run db:up",
    "start": "node src/server.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "dotenv": "^18.0.10",
    "mongodb": "^7.8.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
